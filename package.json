{
  "name": "create-appncy",
  "version": "1.1.89",
  "description": "Create projects as goncy would",
  "keywords": [
    "goncy",
    "next.js",
    "react",
    "shadcn",
    "tailwindcss"
  ],
  "license": "ISC",
  "author": "goncy",
  "bin": {
    "create-appncy": "dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "build": "tsup",
    "registry": "shadcn build",
    "start": "node dist/index.js",
    "dev": "tsup --watch",
    "test": "node --test test/*.test.mjs",
    "format": "oxfmt",
    "bump": "pnpm run build && pnpm run registry && git add -A . && git commit -m 'bump' && pnpm version patch && git tag latest --force && git push origin main --tags --force && pnpm publish --tag latest --force"
  },
  "dependencies": {
    "glob": "^14.0.6",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "shadcn": "^4.23.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  }
}
