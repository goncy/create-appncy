{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "appncy",
  "homepage": "https://github.com/goncy/create-appncy",
  "items": [
    {
      "name": "oxlint-next-ts-tailwind",
      "type": "registry:item",
      "title": "Oxlint + Oxfmt - Next.js + TypeScript + TailwindCSS",
      "description": "Oxlint and Oxfmt configuration for Next.js, TypeScript, and TailwindCSS projects",
      "devDependencies": ["oxfmt", "oxlint", "oxlint-tsgolint"],
      "files": [
        {
          "path": "templates/next-eslint-ts-tw/project/.oxlintrc.json",
          "type": "registry:file",
          "target": "~/.oxlintrc.json"
        },
        {
          "path": "templates/next-eslint-ts-tw/project/.oxfmtrc.json",
          "type": "registry:file",
          "target": "~/.oxfmtrc.json"
        },
        {
          "path": "templates/next-eslint-ts-tw/project/oxlint-plugin.mjs",
          "type": "registry:file",
          "target": "~/oxlint-plugin.mjs"
        }
      ]
    }
  ]
}
